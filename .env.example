# dsh-web-search-yandex — переменные окружения плагина
# (значения можно задать и прямо в конфиге строки плагина, см. README)

# Креды Yandex Cloud Search API (обязательные):
# YANDEX_API_KEY=AQVN...
# YANDEX_FOLDER_ID=b1g...

# Параметры поиска (необязательные):
# YANDEX_SEARCH_API_URL=https://searchapi.api.cloud.yandex.net/v2/web/search
# YANDEX_SEARCH_TYPE=SEARCH_TYPE_RU
# YANDEX_L10N=LOCALIZATION_RU
# YANDEX_MAX_RESULTS=10
