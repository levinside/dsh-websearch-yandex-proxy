# dsh-websearch-yandex-proxy — настройки (скопируйте в окружение или .env)

# Слушаем только локально
# YANDEX_PROXY_HOST=127.0.0.1
# YANDEX_PROXY_PORT=8787

# Бэкенд: auto | api | scrape | mock
# YANDEX_BACKEND=auto

# Официальный Yandex Cloud Search API (рекомендуется):
# YANDEX_API_KEY=AQVN...
# YANDEX_FOLDER_ID=b1g...
# YANDEX_SEARCH_API_URL=https://searchapi.api.cloud.yandex.net/v2/web/search
# YANDEX_SEARCH_TYPE=SEARCH_TYPE_RU
# YANDEX_L10N=LOCALIZATION_RU

# Scrape-резерв (лучше не рассчитывать — Yandex почти всегда отдаёт капчу):
# YANDEX_SCRAPE_HOST=yandex.com

# YANDEX_REQUEST_TIMEOUT_MS=15000
# YANDEX_MAX_RESULTS=10
